# --- Data mode -------------------------------------------------------------
# Leave the Supabase variables unset to run in demo mode (labelled sample data,
# no accounts). Set APP_DATA_MODE=demo to force demo mode even when
# Supabase is configured.
# APP_DATA_MODE=demo

# --- Supabase (Milestone B) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the research runner, seeding and invitation emails.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the deployment, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Research (Milestone C) -----------------------------------------------
# Server-only. Without it, research runs are disabled and feedback suggestions
# fall back to deterministic templates.
OPENAI_API_KEY=
# Model used for extraction, assessment and web-grounded research.
RESEARCH_MODEL=gpt-5-mini
# Price assumptions (USD per 1M tokens) for cost estimates only.
RESEARCH_MODEL_INPUT_USD_PER_M=0.25
RESEARCH_MODEL_OUTPUT_USD_PER_M=2
# Shared secret that Vercel Cron (or any scheduler) must send as
# `Authorization: Bearer <CRON_SECRET>` to /api/research/run.
CRON_SECRET=
# Household the scheduled run targets (uuid). Required for cron runs.
RESEARCH_HOUSEHOLD_ID=

# --- Phone notifications (Web Push) -----------------------------------------
# Generate with `npx web-push generate-vapid-keys`. Without them the Me page
# says notifications are not set up and nothing is sent.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: an https URL or mailto: address (defaults to NEXT_PUBLIC_SITE_URL).
VAPID_SUBJECT=

# --- Seeding ---------------------------------------------------------------
# Comma-separated emails for the three household members (owner first).
# Used only by `npm run seed:demo`; never committed.
SEED_MEMBER_EMAILS=
SEED_MEMBER_NAMES=Jamie,George,Chris
